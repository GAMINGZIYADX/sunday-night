{
  "name": "sunday-night",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "description": "Sunday Night - a cozy first-person puzzle house.",
  "author": "GAMINGZIYADX",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:debug": "vite build --mode debug --outDir dist-debug",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "npm run build && npm run build:debug && node e2e/run-all.mjs",
    "app": "vite build && electron .",
    "build:app": "vite build && electron-builder --win --publish never",
    "build:apk": "node scripts/build-apk.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "electron": "44.5.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.56.1",
    "three": "0.162.0",
    "vite": "^6.4.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.gamingziyadx.sundaynight",
    "productName": "Sunday Night",
    "files": [
      "dist/index.html",
      "desktop/**/*"
    ],
    "directories": {
      "output": "dist-app"
    },
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "artifactName": "Sunday-Night-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "GAMINGZIYADX",
      "repo": "sunday-night"
    }
  }
}
